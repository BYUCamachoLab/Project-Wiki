# =================================================================
# SERVER 2: INVENTREE (Listens on Port 8150)
# =================================================================
https://camacholab.ee.byu.edu:8443 {
    
    # 1. Serve Static Files (CSS/JS)
    # Because we are on a dedicated port, we can serve "/static" directly
    # without worrying about conflicting with the Wiki's static files.
    handle_path /static/* {
        root * /home/camacho/inventree_docker/inventree-data/static
        file_server
    }

    # 2. Serve Media Files (Images)
    handle_path /media/* {
        root * /home/camacho/inventree_docker/inventree-data/media
        file_server
    }

    # 3. Proxy Application
    # We send traffic to the Docker container (which is mapped to 8092)
    reverse_proxy 127.0.0.1:8092
}



